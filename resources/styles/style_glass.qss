/*
 * Glass Theme
 * Liquid Glass Design (Glassmorphism)
 * Primary Accent: #6c5ce7
 */

* {
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 14px;
}

QWidget {
    background-color: rgba(255, 255, 255, 0.1);
    color: #ffffff;
}

QMainWindow {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #667eea, stop:0.5 #764ba2, stop:1 #6B8DD6);
}

/* ===== SIDEBAR CONTAINER ===== */
QWidget#sidebarContainer {
    background: rgba(255, 255, 255, 0.05);
}

/* ===== SIDEBAR ===== */
QWidget#sidebar {
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 20px;
}

QLabel#sidebarLogo {
    font-size: 22px;
    font-weight: bold;
    color: #ffffff;
    padding: 16px 8px 24px 8px;
    text-shadow: 0 2px 4px rgba(0,0,0,0.abel#userInfo2);
}

QLLabel {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.8);
    padding: 8px;
}

QFrame#sidebarSeparator {
    background-color: rgba(255, 255, 255, 0.2);
    border: none;
}

QPushButton#sidebarButton {
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 14px 16px;
    text-align: left;
    font-size: 14px;
    font-weight: 500;
}

QPushButton#sidebarButton:hover {
    background: rgba(255, 255, 255, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.3);
}

QPushButton#sidebarButton:checked {
    background: rgba(108, 92, 231, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.4);
    color: #ffffff;
}

QPushButton#sidebarButton:pressed {
    background: rgba(108, 92, 231, 0.8);
}

QPushButton#sidebarLogoutButton {
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 200, 200, 0.9);
    border: 1px solid rgba(255, 100, 100, 0.2);
    border-radius: 12px;
    padding: 14px 16px;
    text-align: left;
    font-size: 14px;
    font-weight: 500;
}

QPushButton#sidebarLogoutButton:hover {
    background: rgba(255, 100, 100, 0.3);
    border: 1px solid rgba(255, 150, 150, 0.4);
}

QPushButton#sidebarLogoutButton:pressed {
    background: rgba(255, 80, 80, 0.5);
}

/* ===== HEADER BAR ===== */
QWidget#headerBar {
    background: rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
}

QLineEdit#searchField {
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 20px;
    padding: 10px 20px;
    font-size: 14px;
    selection-background-color: rgba(108, 92, 231, 0.6);
    selection-color: #ffffff;
}

QLineEdit#searchField:focus {
    background: rgba(255, 255, 255, 0.25);
    border-color: rgba(255, 255, 255, 0.5);
}

QLineEdit#searchField::placeholder {
    color: rgba(255, 255, 255, 0.5);
}

QPushButton#headerButton {
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 18px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#headerButton:hover {
    background: rgba(255, 255, 255, 0.3);
}

QPushButton#headerButton:pressed {
    background: rgba(108, 92, 231, 0.5);
}

QPushButton#headerCartButton {
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 18px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#headerCartButton:hover {
    background: rgba(255, 255, 255, 0.3);
}

QPushButton#headerAdminButton {
    background: rgba(255, 215, 0, 0.25);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 18px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#headerAdminButton:hover {
    background: rgba(255, 215, 0, 0.4);
}

QPushButton#headerSettingsButton {
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 20px;
    font-size: 16px;
}

QPushButton#headerSettingsButton:hover {
    background: rgba(255, 255, 255, 0.3);
}

QLabel#cartBadge {
    background: rgba(255, 100, 100, 0.9);
    color: #ffffff;
    font-size: 11px;
    font-weight: bold;
    border-radius: 11px;
}

/* ===== CONTENT AREA ===== */
QWidget#contentWrapper {
    background: transparent;
}

QWidget#mainContentArea {
    background: transparent;
}

/* ===== PAGE WRAPPER & BACK BUTTON ===== */
QWidget#pageWrapper {
    background: transparent;
}

QWidget#pageHeader {
    background: rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
}

QPushButton#backButton {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 12px;
    padding: 10px 16px;
    font-size: 14px;
    font-weight: 500;
    text-align: left;
}

QPushButton#backButton:hover {
    background: rgba(255, 255, 255, 0.25);
}

QPushButton#backButton:pressed {
    background: rgba(108, 92, 231, 0.5);
}

/* ===== CATEGORY SIDEBAR ===== */
QWidget#categorySidebar {
    background: rgba(255, 255, 255, 0.08);
    border-right: 1px solid rgba(255, 255, 255, 0.15);
}

QLabel#categoryTitle {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    font-size: 15px;
    font-weight: 600;
    padding: 18px 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
}

QListWidget#categoryList {
    background: transparent;
    border: none;
    outline: none;
}

QListWidget#categoryList::item {
    color: rgba(255, 255, 255, 0.85);
    padding: 14px 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

QListWidget#categoryList::item:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
}

QListWidget#categoryList::item:selected {
    background: rgba(108, 92, 231, 0.5);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 8px;
}

/* ===== PRODUCTS AREA ===== */
QScrollArea#productsScrollArea {
    background: transparent;
    border: none;
}

QWidget#productsContainer {
    background: transparent;
}

QLabel#emptyProductsLabel {
    color: rgba(255, 255, 255, 0.6);
    font-size: 18px;
    padding: 60px;
}

/* ===== PRODUCT CARD ===== */
QWidget#productCard {
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 16px;
}

QWidget#productCard:hover {
    background: rgba(255, 255, 255, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.35);
}

QWidget#imageContainer {
    background: rgba(255, 255, 255, 0.08);
    border-radius: 12px;
}

QLabel#productImage {
    font-size: 48px;
}

QLabel#discountBadge {
    background: rgba(255, 100, 100, 0.85);
    color: #ffffff;
    font-size: 11px;
    font-weight: bold;
    border-radius: 6px;
    padding: 2px 6px;
}

QLabel#brandLabel {
    color: rgba(255, 255, 255, 0.6);
    font-size: 12px;
}

QLabel#nameLabel {
    color: #ffffff;
    font-size: 13px;
}

QLabel#ratingLabel {
    color: rgba(255, 255, 255, 0.7);
    font-size: 12px;
}

QLabel#priceLabel {
    color: #a29bfe;
    font-size: 18px;
    font-weight: bold;
    text-shadow: 0 1px 2px rgba(0,0,0,0.2);
}

QLabel#oldPriceLabel {
    color: rgba(255, 255, 255, 0.4);
    font-size: 13px;
    text-decoration: line-through;
}

QPushButton#addButton {
    background: linear-gradient(135deg, #6c5ce7, #a55eea);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 10px;
    padding: 10px 16px;
    font-size: 13px;
    font-weight: 600;
    box-shadow: 0 4px 15px rgba(108, 92, 231, 0.4);
}

QPushButton#addButton:hover {
    background: linear-gradient(135deg, #7d6ff0, #b46eff);
    box-shadow: 0 6px 20px rgba(108, 92, 231, 0.6);
}

QPushButton#addButton:pressed {
    background: linear-gradient(135deg, #5b4cdb, #8f4fd4);
}

/* ===== */
QWidget#settingsPage {
    background: transparent;
 SETTINGS PAGE =====}

QLabel#pageTitle {
    color: #ffffff;
    font-size: 26px;
    font-weight: bold;
    padding-bottom: 16px;
    text-shadow: 0 2px 4px rgba(0,0,0,0.2);
}

QWidget#settingsCard {
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 16px;
}

QLabel#settingsCardTitle {
    color: #ffffff;
    font-size: 17px;
    font-weight: 600;
}

QLabel#settingsLabel {
    color: #ffffff;
    font-size: 14px;
}

QLabel#settingsDescription {
    color: rgba(255, 255, 255, 0.7);
    font-size: 13px;
    line-height: 1.5;
}

QComboBox#themeComboBox {
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 10px;
    padding: 10px 16px;
    font-size: 14px;
    min-width: 180px;
}

QComboBox#themeComboBox:hover {
    background: rgba(255, 255, 255, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.4);
}

QComboBox#themeComboBox:focus {
    border: 1px solid rgba(255, 255, 255, 0.5);
}

QComboBox#themeComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox#themeComboBox QAbstractItemView {
    background: rgba(45, 45, 80, 0.95);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 10px;
    selection-background-color: rgba(108, 92, 231, 0.7);
    selection-color: #ffffff;
    outline: none;
    padding: 4px;
}

QComboBox#themeComboBox QAbstractItemView::item {
    padding: 10px 16px;
    border-radius: 6px;
}

QComboBox#themeComboBox QAbstractItemView::item:hover {
    background: rgba(255, 255, 255, 0.15);
}

/* ===== GENERIC BUTTONS ===== */
QPushButton {
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 10px;
    padding: 10px 20px;
    font-size: 14px;
    font-weight: 500;
}

QPushButton:hover {
    background: rgba(255, 255, 255, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.35);
}

QPushButton:pressed {
    background: rgba(108, 92, 231, 0.5);
}

QPushButton:disabled {
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.4);
}

QPushButton#primaryButton {
    background: linear-gradient(135deg, #6c5ce7, #a55eea);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 10px;
    padding: 12px 24px;
    font-size: 14px;
    font-weight: 600;
    box-shadow: 0 4px 15px rgba(108, 92, 231, 0.4);
}

QPushButton#primaryButton:hover {
    background: linear-gradient(135deg, #7d6ff0, #b46eff);
    box-shadow: 0 6px 20px rgba(108, 92, 231, 0.6);
}

QPushButton#primaryButton:pressed {
    background: linear-gradient(135deg, #5b4cdb, #8f4fd4);
}

QPushButton#primaryButton:disabled {
    background: rgba(108, 92, 231, 0.3);
    color: rgba(255, 255, 255, 0.5);
    box-shadow: none;
}

QPushButton#secondaryButton {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    border: 2px solid rgba(255, 255, 255, 0.4);
    border-radius: 10px;
    padding: 10px 22px;
    font-size: 14px;
    font-weight: 600;
}

QPushButton#secondaryButton:hover {
    background: rgba(255, 255, 255, 0.2);
    border: 2px solid rgba(255, 255, 255, 0.6);
}

QPushButton#secondaryButton:pressed {
    background: rgba(255, 255, 255, 0.3);
}

/* ===== INPUT FIELDS ===== */
QLineEdit {
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-radius: 10px;
    padding: 10px 14px;
    font-size: 14px;
    selection-background-color: rgba(108, 92, 231, 0.6);
    selection-color: #ffffff;
}

QLineEdit:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.35);
}

QLineEdit:focus {
    background: rgba(255, 255, 255, 0.22);
    border-color: rgba(255, 255, 255, 0.5);
}

QLineEdit:disabled {
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.4);
}

QLineEdit#inputField {
    background: rgba(255, 255, 255, 0.12);
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-radius: 12px;
    padding: 12px 16px;
    font-size: 15px;
}

QLineEdit#inputField:focus {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.45);
}

/* ===== TEXT EDIT ===== */
QTextEdit {
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-radius: 10px;
    padding: 10px;
    font-size: 14px;
    selection-background-color: rgba(108, 92, 231, 0.6);
}

QTextEdit:focus {
    border-color: rgba(255, 255, 255, 0.45);
}

/* ===== COMBO BOX ===== */
QComboBox {
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-radius: 10px;
    padding: 10px 14px;
    font-size: 14px;
    min-width: 100px;
}

QComboBox:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.35);
}

QComboBox:focus {
    border-color: rgba(255, 255, 255, 0.45);
}

QComboBox::drop-down {
    border: none;
    width: 28px;
}

QComboBox QAbstractItemView {
    background: rgba(45, 45, 80, 0.95);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 10px;
    selection-background-color: rgba(108, 92, 231, 0.7);
    selection-color: #ffffff;
    padding: 4px;
}

QComboBox QAbstractItemView::item {
    padding: 8px 12px;
    border-radius: 6px;
}

QComboBox QAbstractItemView::item:hover {
    background: rgba(255, 255, 255, 0.15);
}

/* ===== SPIN BOX ===== */
QSpinBox, QDoubleSpinBox {
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-radius: 10px;
    padding: 8px 12px;
    font-size: 14px;
}

QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: rgba(255, 255, 255, 0.35);
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: rgba(255, 255, 255, 0.45);
}

QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    background: rgba(255, 255, 255, 0.2);
    border: none;
    width: 20px;
    border-radius: 6px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
    background: rgba(255, 255, 255, 0.35);
}

/* ===== TABLE WIDGET ===== */
QTableWidget, QTableView {
    background: rgba(255, 255, 255, 0.08);
    alternate-background-color: rgba(255, 255, 255, 0.04);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 10px;
    gridline-color: rgba(255, 255, 255, 0.1);
    selection-background-color: rgba(108, 92, 231, 0.6);
    selection-color: #ffffff;
}

QTableWidget::item, QTableView::item {
    padding: 10px 14px;
}

QTableWidget::item:hover, QTableView::item:hover {
    background: rgba(255, 255, 255, 0.1);
}

QTableWidget::item:selected, QTableView::item:selected {
    background: rgba(108, 92, 231, 0.6);
    color: #ffffff;
}

QHeaderView::section {
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.85);
    font-weight: 600;
    font-size: 13px;
    padding: 12px 16px;
    border: none;
    border-bottom: 2px solid rgba(108, 92, 231, 0.6);
    border-right: 1px solid rgba(255, 255, 255, 0.1);
}

QHeaderView::section:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
}

QHeaderView::section:last {
    border-right: none;
}

/* ===== SCROLL BAR ===== */
QScrollBar:vertical {
    background: rgba(255, 255, 255, 0.05);
    width: 10px;
    border: none;
    border-radius: 5px;
    margin: 4px;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.25);
    border-radius: 4px;
    min-height: 40px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.4);
}

QScrollBar::handle:vertical:pressed {
    background: rgba(108, 92, 231, 0.7);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: rgba(255, 255, 255, 0.05);
    height: 10px;
    border: none;
    border-radius: 5px;
    margin: 4px;
}

QScrollBar::handle:horizontal {
    background: rgba(255, 255, 255, 0.25);
    border-radius: 4px;
    min-width: 40px;
}

QScrollBar::handle:horizontal:hover {
    background: rgba(255, 255, 255, 0.4);
}

QScrollBar::handle:horizontal:pressed {
    background: rgba(108, 92, 231, 0.7);
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* ===== LIST WIDGET ===== */
QListWidget, QListView {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    outline: none;
}

QListWidget::item, QListView::item {
    padding: 12px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

QListWidget::item:hover, QListView::item:hover {
    background: rgba(255, 255, 255, 0.12);
}

QListWidget::item:selected, QListView::item:selected {
    background: rgba(108, 92, 231, 0.6);
    color: #ffffff;
}

/* ===== GROUP BOX ===== */
QGroupBox {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 14px;
    margin-top: 14px;
    padding: 20px 16px 16px 16px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 16px;
    padding: 0 8px;
    color: #a29bfe;
}

QGroupBox#formGroup {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 14px;
}

/* ===== CHECK BOX ===== */
QCheckBox {
    color: #ffffff;
    spacing: 10px;
}

QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.1);
}

QCheckBox::indicator:hover {
    border-color: rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0.2);
}

QCheckBox::indicator:checked {
    background: linear-gradient(135deg, #6c5ce7, #a55eea);
    border-color: rgba(255, 255, 255, 0.5);
}

/* ===== RADIO BUTTON ===== */
QRadioButton {
    color: #ffffff;
    spacing: 10px;
}

QRadioButton::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.1);
}

QRadioButton::indicator:hover {
    border-color: rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0.2);
}

QRadioButton::indicator:checked {
    background: linear-gradient(135deg, #6c5ce7, #a55eea);
    border-color: rgba(255, 255, 255, 0.5);
}

/* ===== TOOLTIP ===== */
QToolTip {
    background: rgba(45, 45, 80, 0.95);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
}

/* ===== MESSAGE BOX ===== */
QMessageBox {
    background: rgba(45, 45, 80, 0.98);
}

QMessageBox QLabel {
    color: #ffffff;
    font-size: 14px;
}

QMessageBox QPushButton {
    min-width: 80px;
    padding: 8px 20px;
}

/* ===== PROGRESS BAR ===== */
QProgressBar {
    background: rgba(255, 255, 255, 0.1);
    border: none;
    border-radius: 6px;
    height: 10px;
    text-align: center;
    color: #ffffff;
}

QProgressBar::chunk {
    background: linear-gradient(90deg, #6c5ce7, #a55eea);
    border-radius: 6px;
}

/* ===== TAB WIDGET ===== */
QTabWidget::pane {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 10px;
    margin-top: -1px;
}

QTabBar::tab {
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.7);
    padding: 10px 20px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: none;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    margin-right: 2px;
}

QTabBar::tab:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
}

QTabBar::tab:selected {
    background: rgba(255, 255, 255, 0.12);
    color: #a29bfe;
    font-weight: 600;
}

/* ===== MENU ===== */
QMenu {
    background: rgba(45, 45, 80, 0.95);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 10px;
    padding: 6px;
}

QMenu::item {
    padding: 10px 30px 10px 20px;
    border-radius: 6px;
}

QMenu::item:selected {
    background: rgba(108, 92, 231, 0.6);
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background: rgba(255, 255, 255, 0.1);
    margin: 6px 12px;
}

/* ===== LOGIN/REGISTER WINDOWS ===== */
LoginWindow, RegisterWindow {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #667eea, stop:0.5 #764ba2, stop:1 #6B8DD6);
}

QWidget#formContainer {
    background: rgba(255, 255, 255, 0.15);
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.25);
}

QLabel#logoLabel {
    color: #ffffff;
    font-size: 28px;
    font-weight: bold;
    text-shadow: 0 2px 4px rgba(0,0,0,0.2);
}

QLabel#titleLabel {
    color: #ffffff;
    font-size: 22px;
    font-weight: 600;
    text-shadow: 0 1px 2px rgba(0,0,0,0.2);
}

QLabel#errorLabel {
    color: #ff7675;
    font-size: 13px;
}

QLabel#subtitleLabel {
    color: rgba(255, 255, 255, 0.7);
    font-size: 13px;
}

/* ===== CART PAGE ===== */
QWidget#card {
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 16px;
}

QPushButton#removeButton {
    background: rgba(255, 100, 100, 0.2);
    color: #ff7675;
    border: 1px solid rgba(255, 100, 100, 0.3);
    border-radius: 18px;
    font-size: 14px;
    font-weight: bold;
}

QPushButton#removeButton:hover {
    background: rgba(255, 100, 100, 0.4);
    color: #ffffff;
}

/* ===== PROFILE PAGE ===== */
QLabel#avatarLabel {
    background: rgba(255, 255, 255, 0.15);
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 60px;
}

/* ===== SCROLL AREA ===== */
QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}
